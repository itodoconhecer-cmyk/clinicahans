# Copie para .env.localstack (ignorado pelo Git) e preencha seu token.
# O token LocalStack e diferente das credenciais AWS ficticias abaixo.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_VERSION=2026.10.0
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
# Para um futuro cliente executado no host; em container: http://localstack:4566.
AWS_ENDPOINT_URL=http://localhost:4566

# Necessarios apenas para subir a aplicacao completa.
JWT_SECRET=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Preserve a senha de um volume PostgreSQL existente.
POSTGRES_PASSWORD=postgres
