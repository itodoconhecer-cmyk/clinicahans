limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;
map $http_x_forwarded_proto $gateway_proto {
    default $scheme;
    https https;
}
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    access_log off;
    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    location = /healthz { access_log off; return 200 'ok'; }
    location /api/ {
        limit_req zone=api_limit burst=60 nodelay;
        limit_req_status 429;
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Correlation-Id $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
    }
    location / { try_files $uri $uri/ =404; }
    location ~* \.(html|js)$ { add_header Cache-Control "no-cache"; }
}
