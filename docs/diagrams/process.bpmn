<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_ClinicaHans" targetNamespace="https://clinicahans.local/bpmn">
 <bpmn:process id="Process_JornadaPaciente" name="Jornada do Paciente" isExecutable="false">
  <bpmn:startEvent id="Start" name="Necessidade de atendimento"/>
  <bpmn:task id="T1" name="Identificar/cadastrar paciente"/>
  <bpmn:task id="T2" name="Selecionar médico e horário"/>
  <bpmn:task id="T3" name="Criar agendamento"/>
  <bpmn:task id="T4" name="Confirmar consulta"/>
  <bpmn:exclusiveGateway id="G1" name="Paciente compareceu?"/>
  <bpmn:task id="T5" name="Registrar ausência/cancelamento"/>
  <bpmn:task id="T6" name="Abrir prontuário"/>
  <bpmn:exclusiveGateway id="G2" name="Há alerta crítico?"/>
  <bpmn:task id="T7" name="Exibir alerta clínico"/>
  <bpmn:task id="T8" name="Realizar e registrar atendimento"/>
  <bpmn:exclusiveGateway id="G3" name="Exame necessário?"/>
  <bpmn:task id="T9" name="Solicitar e acompanhar exame"/>
  <bpmn:exclusiveGateway id="G4" name="Retorno necessário?"/>
  <bpmn:task id="T10" name="Criar acompanhamento"/>
  <bpmn:task id="T11" name="Finalizar atendimento"/>
  <bpmn:task id="T12" name="Atualizar faturamento e indicadores"/>
  <bpmn:endEvent id="End" name="Jornada atualizada"/>

  <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T1"/>
  <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2"/>
  <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3"/>
  <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4"/>
  <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="G1"/>
  <bpmn:sequenceFlow id="F6" name="Não" sourceRef="G1" targetRef="T5"/>
  <bpmn:sequenceFlow id="F7" sourceRef="T5" targetRef="End"/>
  <bpmn:sequenceFlow id="F8" name="Sim" sourceRef="G1" targetRef="T6"/>
  <bpmn:sequenceFlow id="F9" sourceRef="T6" targetRef="G2"/>
  <bpmn:sequenceFlow id="F10" name="Sim" sourceRef="G2" targetRef="T7"/>
  <bpmn:sequenceFlow id="F11" sourceRef="T7" targetRef="T8"/>
  <bpmn:sequenceFlow id="F12" name="Não" sourceRef="G2" targetRef="T8"/>
  <bpmn:sequenceFlow id="F13" sourceRef="T8" targetRef="G3"/>
  <bpmn:sequenceFlow id="F14" name="Sim" sourceRef="G3" targetRef="T9"/>
  <bpmn:sequenceFlow id="F15" sourceRef="T9" targetRef="G4"/>
  <bpmn:sequenceFlow id="F16" name="Não" sourceRef="G3" targetRef="G4"/>
  <bpmn:sequenceFlow id="F17" name="Sim" sourceRef="G4" targetRef="T10"/>
  <bpmn:sequenceFlow id="F18" sourceRef="T10" targetRef="T11"/>
  <bpmn:sequenceFlow id="F19" name="Não" sourceRef="G4" targetRef="T11"/>
  <bpmn:sequenceFlow id="F20" sourceRef="T11" targetRef="T12"/>
  <bpmn:sequenceFlow id="F21" sourceRef="T12" targetRef="End"/>
 </bpmn:process>
</bpmn:definitions>
