<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_ClinicaHans" targetNamespace="https://clinicahans.local/bpmn">
 <bpmn:process id="Process_JornadaPaciente" name="Jornada Assistencial da Clínica Hans" isExecutable="false">
  <bpmn:startEvent id="Start" name="Necessidade de atendimento"/>
  <bpmn:task id="Identify" name="Localizar ou cadastrar paciente"/>
  <bpmn:task id="Schedule" name="Selecionar médico, disponibilidade e agendar"/>
  <bpmn:task id="Notify" name="Solicitar confirmação"/>
  <bpmn:exclusiveGateway id="Attendance" name="Paciente compareceu?"/>
  <bpmn:task id="NoShow" name="Registrar cancelamento/ausência e liberar capacidade"/>
  <bpmn:task id="CheckIn" name="Realizar check-in"/>
  <bpmn:task id="SafetySnapshot" name="Abrir prontuário e carregar safety snapshot"/>
  <bpmn:exclusiveGateway id="CriticalAlert" name="Há alerta clínico crítico?"/>
  <bpmn:task id="AcknowledgeRisk" name="Apresentar contexto crítico ao médico"/>
  <bpmn:task id="Care" name="Realizar atendimento e registrar evolução"/>
  <bpmn:exclusiveGateway id="NeedExam" name="Há exame solicitado?"/>
  <bpmn:task id="Exam" name="Criar pedido e acompanhar resultado"/>
  <bpmn:exclusiveGateway id="NeedFollowUp" name="Há continuidade necessária?"/>
  <bpmn:task id="FollowUp" name="Criar acompanhamento com responsável e prazo"/>
  <bpmn:task id="Finalize" name="Finalizar registro clínico"/>
  <bpmn:task id="Billing" name="Gerar lançamento financeiro"/>
  <bpmn:task id="Metrics" name="Atualizar eventos para indicadores"/>
  <bpmn:endEvent id="End" name="Etapa da jornada concluída"/>

  <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="Identify"/>
  <bpmn:sequenceFlow id="F02" sourceRef="Identify" targetRef="Schedule"/>
  <bpmn:sequenceFlow id="F03" sourceRef="Schedule" targetRef="Notify"/>
  <bpmn:sequenceFlow id="F04" sourceRef="Notify" targetRef="Attendance"/>
  <bpmn:sequenceFlow id="F05" name="Não" sourceRef="Attendance" targetRef="NoShow"/>
  <bpmn:sequenceFlow id="F06" sourceRef="NoShow" targetRef="Metrics"/>
  <bpmn:sequenceFlow id="F07" name="Sim" sourceRef="Attendance" targetRef="CheckIn"/>
  <bpmn:sequenceFlow id="F08" sourceRef="CheckIn" targetRef="SafetySnapshot"/>
  <bpmn:sequenceFlow id="F09" sourceRef="SafetySnapshot" targetRef="CriticalAlert"/>
  <bpmn:sequenceFlow id="F10" name="Sim" sourceRef="CriticalAlert" targetRef="AcknowledgeRisk"/>
  <bpmn:sequenceFlow id="F11" sourceRef="AcknowledgeRisk" targetRef="Care"/>
  <bpmn:sequenceFlow id="F12" name="Não" sourceRef="CriticalAlert" targetRef="Care"/>
  <bpmn:sequenceFlow id="F13" sourceRef="Care" targetRef="NeedExam"/>
  <bpmn:sequenceFlow id="F14" name="Sim" sourceRef="NeedExam" targetRef="Exam"/>
  <bpmn:sequenceFlow id="F15" sourceRef="Exam" targetRef="NeedFollowUp"/>
  <bpmn:sequenceFlow id="F16" name="Não" sourceRef="NeedExam" targetRef="NeedFollowUp"/>
  <bpmn:sequenceFlow id="F17" name="Sim" sourceRef="NeedFollowUp" targetRef="FollowUp"/>
  <bpmn:sequenceFlow id="F18" sourceRef="FollowUp" targetRef="Finalize"/>
  <bpmn:sequenceFlow id="F19" name="Não" sourceRef="NeedFollowUp" targetRef="Finalize"/>
  <bpmn:sequenceFlow id="F20" sourceRef="Finalize" targetRef="Billing"/>
  <bpmn:sequenceFlow id="F21" sourceRef="Billing" targetRef="Metrics"/>
  <bpmn:sequenceFlow id="F22" sourceRef="Metrics" targetRef="End"/>
 </bpmn:process>
</bpmn:definitions>
