stateDiagram-v2
  state "Agenda" as Agenda {
    [*] --> SCHEDULED
    SCHEDULED --> CONFIRMED: confirmar
    SCHEDULED --> CHECKED_IN: check-in direto permitido
    SCHEDULED --> CANCELLED: cancelar
    SCHEDULED --> NO_SHOW: ausência
    CONFIRMED --> CHECKED_IN: check-in
    CONFIRMED --> CANCELLED: cancelar
    CONFIRMED --> NO_SHOW: ausência
    CHECKED_IN --> IN_CARE: médico inicia atendimento
    CHECKED_IN --> CANCELLED: exceção operacional
    IN_CARE --> COMPLETED: atendimento finalizado
    COMPLETED --> [*]
    CANCELLED --> [*]
    NO_SHOW --> [*]
  }

  state "Atendimento" as Encounter {
    [*] --> DRAFT
    DRAFT --> DRAFT: salvar rascunho/versionar
    DRAFT --> FINAL: finalizar com avaliação
    FINAL --> FINAL: adendo separado
    FINAL --> [*]
  }

  state "Exames" as Exam {
    [*] --> REQUESTED
    REQUESTED --> PERFORMED: realização registrada
    REQUESTED --> RESULT_RECEIVED: resultado recebido
    PERFORMED --> RESULT_RECEIVED: resultado recebido
    RESULT_RECEIVED --> REVIEWED: médico revisa
    REQUESTED --> CANCELLED: cancelar
    PERFORMED --> CANCELLED: cancelar
    REVIEWED --> [*]
    CANCELLED --> [*]
  }

  state "Follow-up" as FollowUp {
    [*] --> OPEN
    OPEN --> OVERDUE: prazo expirou (estado derivado)
    OPEN --> CLOSED: concluir
    OVERDUE --> CLOSED: concluir
    CLOSED --> [*]
  }

  state "Fila de espera" as Waitlist {
    [*] --> WAITING
    WAITING --> RESOLVED: converter em agendamento
    RESOLVED --> [*]
  }
