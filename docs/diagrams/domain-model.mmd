  SPECIALTY ||--o{ DOCTOR_SPECIALTY : classifies
  DOCTOR ||--o{ DOCTOR_AVAILABILITY : offers
  DOCTOR ||--o{ SCHEDULE_BLOCK : blocks
  APPOINTMENT ||--o{ APPOINTMENT_STATUS_HISTORY : transitions

  PATIENT ||--o{ ENCOUNTER : receives
  DOCTOR ||--o{ ENCOUNTER : performs
